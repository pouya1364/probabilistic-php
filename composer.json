{
    "name": "pouya1364/probabilistic-php",
    "description": "Pure-PHP probabilistic data structures: Bloom Filter, Counting Bloom Filter, Cuckoo Filter, Count-Min Sketch, and HyperLogLog. Zero dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "bloom-filter",
        "cuckoo-filter",
        "count-min-sketch",
        "hyperloglog",
        "probabilistic-data-structures",
        "algorithms"
    ],
    "authors": [
        {
            "name": "pouya1364"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-hash": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "Probabilistic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Probabilistic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse",
        "check": [
            "@analyse",
            "@lint",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
